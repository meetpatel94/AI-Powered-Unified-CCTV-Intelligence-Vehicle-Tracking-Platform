# ============================================================================
# Gujarat Police CCTV Intelligence — production Docker configuration.
# Copy to `.env` and set strong values. NEVER commit the real `.env`.
# Generate the JWT secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================================

# --- Database ---------------------------------------------------------------
POSTGRES_USER=cctv
POSTGRES_DB=cctv_intelligence
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
# Host-port bindings (default bind to loopback only).
DB_HOST_PORT=127.0.0.1:5432
BACKEND_HOST_PORT=127.0.0.1:8000
DASHBOARD_HOST_PORT=80

# --- Security ---------------------------------------------------------------
# Required in production.
JWT_SECRET_KEY=CHANGE-ME-generate-a-random-48-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# First-run bootstrap admin (created only when no users exist).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@gujaratpolice.local

# Extra allowed browser origins (the dashboard is same-origin via the proxy).
CORS_ORIGINS=http://localhost

# --- Sentinel catalogue (official dynamic camera source) --------------------
SENTINEL_BASE_URL=https://sentinel.gujarat.gov.in
SENTINEL_INGEST_PATH=/api/ingest
SENTINEL_API_KEY=
SENTINEL_API_SECRET=
SENTINEL_VERIFY_TLS=true

# --- Streams / pipeline -----------------------------------------------------
STREAM_RTSP_TRANSPORT=tcp
STREAM_MAX_WORKERS=32
STREAM_AUTO_START=true
STREAM_AUTO_START_LIMIT=4
VEHICLE_PIPELINE_ENABLED=true
# Path on the HOST containing genuine YOLO weights (mounted read-only /models).
MODEL_WEIGHTS_PATH=./models
VEHICLE_MODEL_PATH=/models/yolov8n.pt
VEHICLE_DEVICE=auto
VEHICLE_INFER_FPS=5
AI_MAX_CONCURRENT_INFERENCE=4

LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
