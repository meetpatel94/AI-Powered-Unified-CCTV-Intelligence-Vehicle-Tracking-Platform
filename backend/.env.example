# Application
APP_NAME=GP CCTV Intelligence API
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# CORS — comma-separated origins. Include the Vite frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL + PostGIS
DATABASE_URL=postgresql+psycopg2://cctv:cctv@localhost:5432/cctv_intelligence

# Gujarat Police Sentinel catalogue (official dynamic source)
# Never hard-code camera URLs. All credentials live here, never in git.
SENTINEL_BASE_URL=https://sentinel.gujarat.gov.in
SENTINEL_INGEST_PATH=/api/ingest
SENTINEL_API_KEY=
SENTINEL_API_SECRET=
SENTINEL_TIMEOUT_SECONDS=15.0
SENTINEL_VERIFY_TLS=true

# Stream gateway (FFmpeg). Never put camera RTSP URLs here — they come from Sentinel.
FFMPEG_PATH=ffmpeg
STREAM_RTSP_TRANSPORT=tcp
STREAM_CONNECT_TIMEOUT_SECONDS=10.0
STREAM_STALE_SECONDS=8.0
STREAM_BACKOFF_MIN_SECONDS=2.0
STREAM_BACKOFF_MAX_SECONDS=30.0
STREAM_JPEG_QUALITY=5
STREAM_AI_MAX_WIDTH=1280
STREAM_AUTO_START=true
STREAM_AUTO_START_LIMIT=1
STREAM_MAX_WORKERS=32

# --- Vehicle Intelligence Pipeline ------------------------------------------
# Dev convenience: create ORM tables at startup when not using Alembic.
AUTO_CREATE_TABLES=false

VEHICLE_PIPELINE_ENABLED=true
VEHICLE_PIPELINE_AUTO_ATTACH=true
VEHICLE_PIPELINE_MAX_WORKERS=16

# Detection (YOLO / Ultralytics).
# Point VEHICLE_MODEL_PATH at GENUINE pretrained vehicle weights (e.g. a real
# yolov8n.pt COCO checkpoint or a custom vehicle model). This is the ONLY source
# of real detections. If the file is missing/unloadable the detector reports
# MODEL_NOT_READY and produces NO detections (fail-safe) — it never fabricates
# output. The stream gateway and APIs keep running regardless.
VEHICLE_MODEL_PATH=yolov8n.pt
#
# DEVELOPMENT ONLY. Leave FALSE in production. When True and real weights can't
# be loaded, an architecture-only (RANDOM/untrained) model is built so the
# pipeline can be exercised offline. Its detections are meaningless, are
# hard-labelled synthetic=true on the WebSocket + pipeline status, and are NEVER
# persisted to the database or served by the vehicle/journey APIs.
VEHICLE_ALLOW_SYNTHETIC_FALLBACK=false
VEHICLE_MODEL_FALLBACK_YAML=yolov8n.yaml
VEHICLE_CONF_THRESHOLD=0.35
VEHICLE_IOU_THRESHOLD=0.45
VEHICLE_INFER_FPS=5.0
VEHICLE_INFER_IMGSZ=640
# cpu | cuda | cuda:0 | auto (auto uses CUDA when available)
VEHICLE_DEVICE=auto
VEHICLE_CLASSES=car,motorcycle,bus,truck,bicycle

# Tracking: bytetrack.yaml or botsort.yaml (or an absolute path to a custom cfg)
TRACKER_CONFIG=bytetrack.yaml
TRACK_TRAJECTORY_MAX_POINTS=240

# ANPR / OCR
ANPR_ENABLED=true
ANPR_OCR_PROVIDER=rapidocr
ANPR_PLATE_DETECTOR=region
ANPR_MIN_OCR_CONFIDENCE=0.40
ANPR_DEDUPE_SECONDS=20.0

# Evidence frames (small JPEG crops only — never continuous video)
EVIDENCE_FRAMES_ENABLED=true
EVIDENCE_FRAMES_DIR=shots/evidence
# Capture a full live-frame snapshot on every watchlist match.
EVIDENCE_CAPTURE_ON_WATCHLIST=true
# Retention window (days) for evidence snapshots; a background task deletes
# expired files + rows.
EVIDENCE_RETENTION_DAYS=30

# --- Real-Time Alerts ---------------------------------------------------------
# Suppress a new alert when an unresolved alert for the same watchlist entry +
# camera exists within this window (duplicate suppression, seconds).
ALERT_DEDUPE_SECONDS=300
# Also raise alerts when a camera sustains an ERROR/OFFLINE state.
ALERT_ON_CAMERA_FAILURE=true

# --- Camera Health Monitoring -------------------------------------------------
# Poll the stream gateway + registry this often (seconds).
CAMERA_HEALTH_POLL_SECONDS=5
# A LIVE stream whose measured FPS falls below this is DEGRADED.
CAMERA_HEALTH_DEGRADED_FPS=1.0
# Consecutive failed polls before a camera is reported OFFLINE.
CAMERA_HEALTH_OFFLINE_GRACE_POLLS=2

# --- Authentication / RBAC ----------------------------------------------------
# When False (development default) the API runs in open mode: an implicit admin
# principal is attached to every request so the dashboard works without a login
# screen. Production MUST set AUTH_ENABLED=true.
AUTH_ENABLED=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE-ME-IN-PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Optional first-run bootstrap admin (created only when no users exist).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=

# Cross-camera journey
JOURNEY_MAX_GAP_SECONDS=3600.0
JOURNEY_MAX_SPEED_KPH=200.0
JOURNEY_MIN_INTERVAL_SECONDS=2.0
