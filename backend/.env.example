# Application
APP_NAME=GP CCTV Intelligence API
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# CORS — comma-separated origins. Include the Vite frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL + PostGIS
DATABASE_URL=postgresql+psycopg2://cctv:cctv@localhost:5432/cctv_intelligence

# Gujarat Police Sentinel catalogue (official dynamic source)
# Never hard-code camera URLs. All credentials live here, never in git.
SENTINEL_BASE_URL=https://sentinel.gujarat.gov.in
SENTINEL_INGEST_PATH=/api/ingest
SENTINEL_API_KEY=
SENTINEL_API_SECRET=
SENTINEL_TIMEOUT_SECONDS=15.0
SENTINEL_VERIFY_TLS=true

# Stream gateway (FFmpeg). Never put camera RTSP URLs here — they come from Sentinel.
FFMPEG_PATH=ffmpeg
STREAM_RTSP_TRANSPORT=tcp
STREAM_CONNECT_TIMEOUT_SECONDS=10.0
STREAM_STALE_SECONDS=8.0
STREAM_BACKOFF_MIN_SECONDS=2.0
STREAM_BACKOFF_MAX_SECONDS=30.0
STREAM_JPEG_QUALITY=5
STREAM_AI_MAX_WIDTH=1280
STREAM_AUTO_START=true
STREAM_AUTO_START_LIMIT=1
STREAM_MAX_WORKERS=32
