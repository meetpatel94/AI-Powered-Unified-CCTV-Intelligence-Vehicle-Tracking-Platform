# ============================================================================
# Dashboard build-time configuration. These are baked in at build time and are
# read by src/config.ts / src/services/*.
#
#   VITE_API_BASE_URL  Single production API prefix. The FastAPI backend serves
#                      EVERY route under /api (there is NO /api/v1 namespace).
#                      Leave as /api in production (the nginx proxy forwards
#                      /api and /api/ws to the backend container same-origin).
#   VITE_WS_URL        Override the realtime WebSocket endpoint. Leave blank to
#                      use /api/ws on the current origin (proxied).
#   VITE_STREAM_GATEWAY  External WebRTC/HLS edge gateway base (MediaMTX/Janus)
#                      used for low-latency browser preview. Leave blank to use
#                      the FastAPI stream gateway's JPEG/MJPEG endpoints. RTSP
#                      is NEVER exposed to the browser either way.
#   VITE_DEMO_MODE     MUST be false in production (default). When true the app
#                      may show bundled demo fixtures behind an explicit demo
#                      badge instead of real backend data.
# ============================================================================
VITE_API_BASE_URL=/api
VITE_WS_URL=
VITE_STREAM_GATEWAY=
VITE_DEMO_MODE=false
