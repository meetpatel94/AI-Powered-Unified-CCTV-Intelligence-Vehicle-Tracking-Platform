# Backend seams — all optional while the UI runs on mock data
VITE_API_BASE_URL=/api
# Realtime WebSocket. Leave blank to use the built-in backend pipeline feed at
# `/api/ws` on the current origin (proxied by Vite in dev). Set this only to
# point the dashboard at an external realtime gateway.
VITE_WS_URL=
VITE_STREAM_GATEWAY=
