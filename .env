# ============================================================================
# Gujarat Police CCTV Intelligence — production Docker configuration.
# Copy to `.env` and set strong values. NEVER commit the real `.env`.
# Generate the JWT secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================================

# --- Database ---------------------------------------------------------------
POSTGRES_USER=cctv
POSTGRES_DB=cctv_intelligence
POSTGRES_PASSWORD=1234
# Host-port bindings (default bind to loopback only).
DB_HOST_PORT=127.0.0.1:5432
BACKEND_HOST_PORT=127.0.0.1:8000
DASHBOARD_HOST_PORT=80

# --- Security ---------------------------------------------------------------
# Required in production.
JWT_SECRET_KEY=SYYwTUzTtGt9zwO9BobafOWUuyBs8T9S3_2TZBvps0UD_zfKiZnSnLbx4THOk4FW
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# First-run bootstrap admin (created only when no users exist).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=1234
BOOTSTRAP_ADMIN_EMAIL=admin@gujaratpolice.local

# Extra allowed browser origins (the dashboard is same-origin via the proxy).
CORS_ORIGINS=http://localhost

# --- Sentinel catalogue (official dynamic camera source) --------------------
SENTINEL_BASE_URL=https://cctv.corp8.cloud
SENTINEL_INGEST_PATH=/api/ingest
SENTINEL_API_KEY=
SENTINEL_API_SECRET=
SENTINEL_VERIFY_TLS=true

# --- Sentinel CCTV Camera Grid (authorized integrator access) ---------------
# The camera catalogue is fetched DYNAMICALLY from this URL. Camera ids
# (cam01..camNN) are never hard-coded anywhere in the codebase.
SENTINEL_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
# REQUIRED. Credentials are backend-only and are NEVER exposed to the browser.
# The '@' in the email is URL-encoded to %40 automatically when embedded in
# RTSP/WHEP URLs. NEVER commit the real .env.
SENTINEL_EMAIL=meetpatel96645@gmail.com
SENTINEL_PASSWORD=V984-E2RT-V9KZ
# Per-camera endpoint templates ({camera_id}/{email}/{password} are substituted).
SENTINEL_HLS_URL_TEMPLATE=https://cctv.corp8.cloud/{camera_id}/index.m3u8
SENTINEL_RTSP_URL_TEMPLATE=rtsp://{email}:{password}@103.250.160.189:8554/stream/{camera_id}
SENTINEL_WEBRTC_URL_TEMPLATE=http://{email}:{password}@103.250.160.189:8889/stream/{camera_id}/whep

# --- Streams / pipeline -----------------------------------------------------
STREAM_RTSP_TRANSPORT=tcp
STREAM_MAX_WORKERS=32
STREAM_AUTO_START=true
STREAM_AUTO_START_LIMIT=4
VEHICLE_PIPELINE_ENABLED=true
# Path on the HOST containing genuine YOLO weights (mounted read-only /models).
MODEL_WEIGHTS_PATH=./models
VEHICLE_MODEL_PATH=/models/yolov8n.pt
VEHICLE_DEVICE=auto
VEHICLE_INFER_FPS=5
AI_MAX_CONCURRENT_INFERENCE=4

# --- ANPR reliability / AI status / cross-camera matching -------------------
# Grammar-valid AND >= this OCR confidence → reliable (drives Vehicle Identity,
# journey and watchlist). Lower reads are persisted but marked uncertain.
ANPR_RELIABLE_CONFIDENCE=0.75
# Seconds between low-frequency `ai:status` realtime frames.
AI_STATUS_PUBLISH_SECONDS=15.0
# OFF by default: only plate-identity cross-camera matching is certain. When
# ON, clearly-labelled low-confidence metadata candidates may be returned too.
CROSS_CAMERA_VISUAL_MATCH_ENABLED=false

LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
